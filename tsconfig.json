{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"types": ["node"],
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true
	},
	"include": [
		"src/usage/abort-utils.ts",
