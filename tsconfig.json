		"src/accounts/auth.ts",
		"src/ui/browser.ts",
		"src/accounts/codex-oauth.ts",
		"src/provider/codex-provider.ts",
		"src/ui/commands.ts",
		"src/extension/extension-loader.test.ts",
		"src/extension/extension.test.ts",
		"src/extension/extension.ts",
		"src/extension/hooks.test.ts",
		"src/extension/hooks.ts",
		"src/index.ts",
		"src/index.test.ts",
		"src/provider/provider.ts",
		"src/provider/quota.ts",
		"src/accounts/selection.ts",
		"src/platform/**/*.ts",
		"src/ui/status.ts",
		"src/accounts/storage.ts",
		"src/provider/stream-wrapper.ts",
